# ==========================================
# 🌿 CampusEco - Git Ignore Configuration
# ==========================================

# 1. Environment & Secret Keys (CRITICAL: Do NOT push to GitHub)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
server/.env
server/.env.*
client/.env
client/.env.*
*.env

# Exception: allow template examples to be tracked
!.env.example
!server/.env.example
!client/.env.example

# 2. Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# 3. Build Outputs & Compilations
dist/
dist-ssr/
*/dist/
build/
*/build/
out/
.vite/
*/.vite/
*.tsbuildinfo

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS Generated & Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. IDEs & Editor Configuration
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# 7. Testing & Coverage
coverage/
*.lcov
.nyc_output/

# 8. Temporary and Cache Directories
.cache/
.temp/
.tmp/
tmp/
